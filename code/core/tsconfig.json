{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "stripInternal": true
  },
  "include": [
    "src/**/*",
    "template/react/**/*",
    "scripts/**/*",
    "*.d.ts",
    "templates/runtime-build-code.template"
  ],
  // Next.js code has its own project (tsconfig.nextjs.json), so the global Next.js types stay there.
  "exclude": ["dist", "src/nextjs-vite/**", "src/nextjs-vite-plugin/**"]
}
