{
  "version": 1,
  "detected": [
    "workspace",
    "vercel",
    "workflows",
    "domains"
  ],
  "workspace": {
    "packageManager": "bun",
    "packages": [
      {
        "name": "forkbook-root",
        "dir": ".",
        "version": null,
        "private": true,
        "description": null,
        "bin": [],
        "exports": [],
        "scripts": {
          "browsers": "bun --bun node_modules/playwright/cli.js install chromium-headless-shell",
          "build": "bun --cwd=scripts ./build-package.ts --all --no-watch --prod",
          "build:changed": "bun --cwd=scripts ./build-package.ts --changed --no-watch --prod",
          "fmt:check": "oxfmt --check .",
          "fmt:write": "oxfmt .",
          "lint": "cd code && bun run lint",
          "merge-agent": "bun scripts/merge-agent.ts",
          "site:build": "bun --cwd=site run build",
          "site:dev": "bun --cwd=site run dev",
          "forkbook:vitest": "NODE_OPTIONS=--max_old_space_size=4096 vitest watch --project forkbook-ui",
          "test": "NODE_OPTIONS=--max_old_space_size=4096 vitest run",
          "test:changed": "NODE_OPTIONS=--max_old_space_size=4096 vitest run --changed",
          "test:ui": "NODE_OPTIONS=--max_old_space_size=4096 vitest run --project forkbook-ui",
          "test:unit": "NODE_OPTIONS=--max_old_space_size=4096 vitest run --project '!forkbook-ui'",
          "test:watch": "NODE_OPTIONS=--max_old_space_size=4096 vitest watch",
          "typecheck": "bun check -b -p code/tsconfig.packages.json",
          "verify": "bun scripts/verify.ts",
          "site:deploy": "bun run site:build && cp -R site/.vercel site/dist/ && cd site/dist && vercel deploy --prod --yes --scope coinsurgers-projects",
          "workflows": "bun ci/generate.ts",
          "workflows:check": "bun ci/generate.ts --check"
        },
        "internalDeps": [],
        "dependencies": []
      },
