{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "settings": {
    "react": {
      "version": "19.3.0"
    }
  },
  "jsPlugins": [
    { "name": "local-rules", "specifier": "../scripts/eslint-plugin-local-rules/index.js" }
  ],
  "ignorePatterns": [
    "forkbook-static",
    "**/__testfixtures__",
    "**/__mockdata__",
    "core/assets",
    "core/src/cli-commands/test/default/cli.test.cjs"
  ],
  "rules": {
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@base-ui/react",
            "message": "Don't import from the @base-ui/react root, but use the @base-ui/react/component entrypoints which are optimised for tree-shaking",
            "allowTypeImports": true
          },
          {
            "name": "es-toolkit",
            "message": "Don't import from es-toolkit root, but use the sub-exports like es-toolkit/array entrypoints instead which are optimised for tree-shaking.",
            "allowTypeImports": true
          }
        ]
      }
    ],
    "react/no-unknown-property": [
      "error",
      { "ignore": ["jsx", "global", "popovertarget", "popovertargetaction"] }
    ],
    "react/rules-of-hooks": "off",
    "typescript/triple-slash-reference": "off"
  },
  "overrides": [
    {
      "files": ["**/template/**", "**/templates/**"],
      "rules": {
        "jsx-a11y/anchor-is-valid": "off"
      }
    },
    {
      "files": ["**/*.ts"],
      "rules": {
        "local-rules/no-uncategorized-errors": "warn"
      }
    },
    {
      "files": ["core/src/cli/skills/content/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/core-server/**"],
                "message": "`cli/skills/content` is the pure `@aussieljk/forkbook/internal/skills` entry; probing and anything server-side belongs in `cli/skills/` outside `content/`."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.compat.ts", "**/*.compat.tsx"],
      "rules": {
        "local-rules/no-uncategorized-errors": "off"
      }
    },
    {
      "files": ["**/core/src/preview-errors.ts"],
      "rules": {
        "local-rules/no-duplicated-error-codes": "error"
      }
    },
    {
      "files": ["**/*.test.*", "**/*.spec.*", "**/*.test-d.*", "**/*.mockdata.*"],
      "rules": {
        "local-rules/no-uncategorized-errors": "off"
      }
    },
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.test-d.*",
        "**/*.stories.*",
        "**/*.mockdata.*",
        "**/__tests__/**",
        "**/template/**"
      ],
      "rules": {
        "jsx-a11y/alt-text": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/iframe-has-title": "off",
        "jsx-a11y/no-static-element-interactions": "off"
      }
    }
  ]
}
