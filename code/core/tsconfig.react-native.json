{
  "extends": "./tsconfig.json",
  // The React Native code that runs on the device. React Native declares its own globals (timers,
  // fetch), so it has its own project. Its Node side (metro/, scripts/, bin/) is in the core project.
  "include": [
    "src/react-native/**/*",
    "src/react-native-ui/**/*",
    "src/react-native-ui-common/**/*",
    "src/react-native-theming/**/*",
    "src/addon-ondevice-controls/**/*",
    "src/addon-ondevice-actions/**/*",
    "assets/react-native/*.d.ts"
  ],
  "exclude": [
    "dist",
    "src/react-native/metro/**",
    "src/react-native/scripts/**",
    "src/react-native/bin/**"
  ]
}
