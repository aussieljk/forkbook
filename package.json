{
  "name": "forkbook-root",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "code",
      "code/core",
      "scripts"
    ]
  },
  "scripts": {
    "browsers": "pw-browsers",
    "build": "bun --cwd=scripts ./build-package.ts --all --no-watch --prod",
    "build:changed": "bun --cwd=scripts ./build-package.ts --changed --no-watch --prod",
    "fmt:check": "oxfmt --check .",
    "fmt:write": "oxfmt .",
    "lint": "cd code && bun run lint",
    "merge-agent": "bun scripts/merge-agent.ts",
    "storybook:vitest": "NODE_OPTIONS=--max_old_space_size=4096 vitest watch --project storybook-ui",
    "test": "NODE_OPTIONS=--max_old_space_size=4096 vitest run",
    "test:changed": "NODE_OPTIONS=--max_old_space_size=4096 vitest run --changed",
    "test:ui": "NODE_OPTIONS=--max_old_space_size=4096 vitest run --project storybook-ui",
    "test:unit": "NODE_OPTIONS=--max_old_space_size=4096 vitest run --project '!storybook-ui'",
    "test:watch": "NODE_OPTIONS=--max_old_space_size=4096 vitest watch",
    "typecheck": "bun check -b -p code/tsconfig.packages.json",
    "verify": "bun scripts/verify.ts"
  },
  "devDependencies": {
    "@types/kill-port": "^2.0.3",
    "http-server": "^14.1.1",
    "jiti": "^2.6.1",
    "kill-port": "^2.0.1",
    "oxfmt": "0.70.0",
    "std-env": "^4.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "^22.19.1",
    "@types/react": "^18.0.0",
    "@typescript-eslint/types": "8.60.0",
    "caniuse-lite": "1.0.30001810",
    "esbuild": "^0.28.0",
    "memfs": "4.56.11",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "react": "^18.2.0",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "valibot": "^1.4.0"
  },
  "patchedDependencies": {
    "@7rulnik/react-element-to-jsx-string@15.0.1": "patches/@7rulnik%2Freact-element-to-jsx-string@15.0.1.patch",
    "@types/babel__traverse@7.28.0": "patches/@types%2Fbabel__traverse@7.28.0.patch",
    "@testing-library/user-event@14.6.3": "patches/@testing-library%2Fuser-event@14.6.3.patch"
  }
}
