{
  "name": "@storybook/react",
  "version": "11.0.0-alpha.6",
  "description": "Storybook React renderer",
  "keywords": [
    "storybook"
  ],
  "homepage": "https://github.com/storybookjs/storybook/tree/next/code/renderers/react",
  "bugs": {
    "url": "https://github.com/storybookjs/storybook/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/storybookjs/storybook.git",
    "directory": "code/renderers/react"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/storybook"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "code": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entry-preview": {
      "code": "./src/entry-preview.tsx",
      "default": "./dist/entry-preview.js"
    },
    "./entry-preview-argtypes": {
      "code": "./src/entry-preview-argtypes.ts",
      "default": "./dist/entry-preview-argtypes.js"
    },
    "./entry-preview-docs": {
      "code": "./src/entry-preview-docs.ts",
      "default": "./dist/entry-preview-docs.js"
    },
    "./entry-preview-rsc": {
      "code": "./src/entry-preview-rsc.tsx",
      "default": "./dist/entry-preview-rsc.js"
    },
    "./internal/docgen-worker": {
      "code": "./src/docgen/docgen-worker.ts",
      "default": "./dist/docgen/docgen-worker.js"
    },
    "./package.json": "./package.json",
    "./preset": {
      "code": "./src/preset.ts",
      "default": "./dist/preset.js"
    },
    "./preview": {
      "code": "./src/preview.tsx",
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    }
  },
  "files": [
    "dist/**/*",
    "template/cli/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "dependencies": {
    "@storybook/global": "^5.0.0",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "devDependencies": {
    "@types/escodegen": "^0.0.6",
    "@types/estree": "^1.0.6",
    "@types/node": "^22.19.1",
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.1",
    "acorn-walk": "^7.2.0",
    "comment-parser": "^1.4.1",
    "empathic": "^2.0.0",
    "es-toolkit": "^1.43.0",
    "escodegen": "^2.1.0",
    "expect-type": "^0.15.0",
    "html-tags": "^3.1.0",
    "memfs": "4.56.11",
    "prop-types": "^15.7.2",
    "react-element-to-jsx-string": "npm:@7rulnik/react-element-to-jsx-string@15.0.1",
    "ts-dedent": "^2.0.0",
    "type-fest": "^5.6.0"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "storybook": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "a8e7fd8a655c69780bc20b9749d2699e45beae1l"
}
