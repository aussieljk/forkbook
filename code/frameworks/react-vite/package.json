{
  "name": "@storybook/react-vite",
  "version": "11.0.0-alpha.6",
  "description": "Storybook for React and Vite: Develop, document, and test UI components in isolation",
  "keywords": [
    "storybook",
    "storybook-framework",
    "react",
    "vite",
    "component",
    "components"
  ],
  "homepage": "https://github.com/storybookjs/storybook/tree/next/code/frameworks/react-vite",
  "bugs": {
    "url": "https://github.com/storybookjs/storybook/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/storybookjs/storybook.git",
    "directory": "code/frameworks/react-vite"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/storybook"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "code": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "code": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json",
    "./preset": {
      "code": "./src/preset.ts",
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    }
  },
  "files": [
    "dist/**/*",
    "template/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "dependencies": {
    "@storybook/builder-vite": "workspace:*",
    "@storybook/react": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "storybook": "workspace:^",
    "vite": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "a8e7fd8a655c69780bc20b9749d2699e45beae1l"
}
