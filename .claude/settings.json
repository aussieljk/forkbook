{
  "env": {
    "OTEL_SERVICE_NAME": "claude-code",
    "OTEL_RESOURCE_ATTRIBUTES": "project=forkbook"
  },
  "hooks": {
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/otel-hook.ts\" subagent-stop" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/otel-hook.ts\" stop" }] }
    ]
  }
}
